{
  "name": "notes-app-root",
  "version": "1.0.0",
  "description": "Full-Stack User Notes Application with Authentication and CRUD",
  "scripts": {
    "start": "node server/src/server.js",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client dev",
    "server": "npm --prefix server start",
    "client": "npm --prefix client dev",
    "test": "npm --prefix server test",
    "build": "npm --prefix client install && npm --prefix client run build && npm --prefix server install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
